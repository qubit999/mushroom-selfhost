{
  // Build-only (see selfhost/messaging/wrangler.build.jsonc): nothing deploys, and no ids,
  // routes or secrets.
  //
  // compatibility_date and compatibility_flags are copied from files-worker/wrangler.jsonc;
  // move them together.
  "name": "mushroom-files-selfhost",
  "main": "entry.js",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],

  "durable_objects": {
    "bindings": [{ "name": "SQL", "class_name": "SqlStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SqlStore"] }],

  // The blob sidecar stands in for R2. Declared so the bundler knows the binding; the capnp
  // points it at blobd's unix socket.
  "services": [{ "binding": "BLOBS", "service": "blobs" }]
}
