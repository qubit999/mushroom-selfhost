# Copy to .env and set PUBLIC_BASE. That's the whole configuration.
#
# The admin token and the keys that address your data are generated on first start and kept in
# secrets.env on the state volume. Read them with:
#
#   docker compose exec workerd cat /var/lib/mushroom/secrets.env
#
# Back that file up. See the Backups section of README.md.

# Required, and get it right: it's in every share link, so a wrong value sends people somewhere
# else for files that live here. The deployment won't start without it.
#
# This is the file sharing address, so it takes the bare hostname with no port: it's the one
# address seen by people not running Mushroom. Friends is the same host on :8443.
PUBLIC_BASE=https://your-box.your-tailnet.ts.net

# Required. Who may activate on this deployment: a space-separated list of licence key hashes, one
# per person:
#
#   printf '%s' 'THEIR-LICENCE-KEY' | tr '[:lower:]' '[:upper:]' | sha256sum
#
# Use printf, never echo: a trailing newline gives a hash that never matches. Hashes, never keys,
# so this file gives nothing away if it leaks.
#
# "*" accepts any string as a key, so anyone who can reach the deployment can activate and upload.
# Use it only when nobody untrusted can reach it, such as a tailnet of your own staff.
ENROLLMENT_HASHES=

# Optional, and empty is a real answer, not a missing one.
#
# Two pages are all this deployment shows someone not running Mushroom: "this link has expired"
# and "this file was removed". Empty means they name nobody and the bare root answers 404, right
# for a box that isn't ours. Set it and both pages link there.
#BRAND_URL=https://intranet.example.com

# Optional. Build from your own registry mirror instead of Docker Hub, as an air-gapped install
# needs. Any Debian-based Node 22 image works.
#BASE=node:22-slim
