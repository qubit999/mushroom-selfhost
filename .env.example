# Copy to .env and set PUBLIC_BASE. That is the whole configuration.
#
# The admin token and the keys that address your data are generated on first start and kept in
# secrets.env on the state volume. Read them back with:
#
#   docker compose exec workerd cat /var/lib/mushroom/secrets.env
#
# Back that file up. See the Backups section of README.md.

# REQUIRED, and get it right. This goes into every share link the deployment hands out, so a wrong
# value gives people links pointing somewhere else for files that live here. The deployment
# refuses to start without it.
#
# This is the FILE SHARING address, which is why it takes the bare hostname with no port: it is
# the one address seen by people who are not running Mushroom. Friends is the same host on :8443.
PUBLIC_BASE=https://your-box.your-tailnet.ts.net

# "*" accepts any licence key, which is the recommended setting.
#
# To restrict the deployment to keys you have named, replace it with a space-separated list of
# hashes, one per person:
#
#   printf '%s' 'THEIR-LICENCE-KEY' | tr '[:lower:]' '[:upper:]' | sha256sum
#
# Use printf, never echo: a trailing newline produces a hash that never matches. Hashes only,
# never keys, so this file gives up nothing if it leaks.
ENROLLMENT_HASHES=*

# Optional, and empty is a real answer rather than a missing one.
#
# Two pages are the only thing this deployment shows a person who is not running Mushroom: "this
# link has expired" and "this file was removed". Empty means they name nobody and the bare root
# answers 404, which is right for a box that has nothing to do with us. Set it and both pages
# link there instead.
#BRAND_URL=https://intranet.example.com

# Optional. Build the image from your own registry mirror instead of Docker Hub, which an
# air-gapped install needs. Any Debian-based Node 22 image works.
#BASE=node:22-slim
