[Unit]
Description=Mushroom blob store
Documentation=file:/opt/mushroom/README.md
# workerd connects lazily, on the first upload or download, so ordering isn't needed for
# correctness; it just keeps a boot from logging a confusing first failure.
Before=mushroom-workerd.service

[Service]
Type=simple
User=mushroom
Group=mushroom
ExecStart=/usr/bin/node /opt/mushroom/blobd.mjs
Restart=always
RestartSec=2

Environment=BLOB_ROOT=/var/lib/mushroom/blobs
Environment=BLOB_SOCKET=/run/mushroom/blobd.sock

# /run/mushroom is shared with mushroom-workerd.service, which declares it too.
# RuntimeDirectoryPreserve stops one unit's shutdown deleting the directory (and sockets) the
# other is still using.
RuntimeDirectory=mushroom
RuntimeDirectoryPreserve=yes
# Just the blobs. StateDirectory= paths are exempt from ProtectSystem=, so `mushroom` here would
# hand this process every database read-write, whatever ReadWritePaths says below.
StateDirectory=mushroom/blobs
UMask=0077

# This process turns strings off a socket into filesystem paths, so it gets the narrowest
# filesystem that still works.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/var/lib/mushroom/blobs
# Read-only isn't enough for these: same user, so it could read every message database and the
# admin token. `-` because a fresh box may not have created them yet.
InaccessiblePaths=-/var/lib/mushroom/do-messaging -/var/lib/mushroom/do-files -/opt/mushroom/config.capnp
# No network at all: it listens on a unix socket and talks to nobody.
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
