[Unit]
Description=Mushroom database backup
Documentation=file:/opt/mushroom/README.md

[Service]
Type=oneshot
User=mushroom
Group=mushroom
ExecStart=/opt/mushroom/backup.sh

Environment=STATE_ROOT=/var/lib/mushroom
Environment=DEST=/var/backups/mushroom
Environment=KEEP=3

UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# Read-write on the state directory looks wrong for a backup, but isn't.
#
# These databases are in WAL mode, and opening one needs write access to its -shm file even for
# a pure reader, so ReadOnlyPaths makes `sqlite3 .backup` fail to open the source. Copying the
# files instead is what this script exists to avoid: a mid-write copy restores corrupt.
ReadWritePaths=/var/lib/mushroom /var/backups/mushroom
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
