[Unit]
Description=Mushroom expiry sweeps, hourly
Documentation=file:/opt/mushroom/README.md

[Timer]
# Hourly, like the files worker's cron when we host it.
OnCalendar=hourly
# Run a missed sweep after a reboot or downtime rather than waiting an hour: expired files left
# on disk are what this prevents.
Persistent=true
# Spread the start so a fleet of boxes doesn't sweep on the same second.
RandomizedDelaySec=5m

[Install]
WantedBy=timers.target
