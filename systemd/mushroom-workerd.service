[Unit]
Description=Mushroom servers (workerd)
Documentation=file:/opt/mushroom/README.md
After=network.target mushroom-blobd.service
Wants=mushroom-blobd.service

[Service]
Type=simple
User=mushroom
Group=mushroom
WorkingDirectory=/opt/mushroom
# workerd neither unlinks its unix sockets on exit nor replaces a stale one on startup: it dies
# with `Address already in use` and, with Restart=always, crash-loops forever.
# RuntimeDirectoryPreserve keeps /run/mushroom across restarts (blobd needs it), so stale sockets
# survive too. Bites on `systemctl restart`, never a first boot. blobd.mjs does the same.
ExecStartPre=-/bin/rm -f /run/mushroom/admin.sock /run/mushroom/files-admin.sock
# Run from the config's directory: capnp resolves `import` relative to the importing file, and
# config.capnp imports dist/*/modules.capnp.
ExecStart=/opt/mushroom/node_modules/.bin/workerd serve /opt/mushroom/config.capnp
Restart=always
RestartSec=2

# Shared with mushroom-blobd.service; see the note there on why Preserve matters.
RuntimeDirectory=mushroom
RuntimeDirectoryPreserve=yes
StateDirectory=mushroom
# The databases hold invite codes and share tokens in clear, and the sockets are the admin
# channel: nobody but this user reads either. Every unit runs as `mushroom`, so cron and backup
# still can.
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
# The durable-object directories: messages and both databases live here.
ReadWritePaths=/var/lib/mushroom

# Listens on loopback for the proxy and on unix sockets for admin and the blob store. It never
# connects out (config.capnp points globalOutbound at a network that allows nothing); this
# enforces the same claim at the system level, checkable with `systemctl show`.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressAllow=localhost
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
