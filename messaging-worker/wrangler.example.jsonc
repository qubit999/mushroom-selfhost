// EXAMPLE. Copy to wrangler.jsonc and fill in your own values.
//
// The real wrangler.jsonc isn't published: it carries our hosted deployment's database ids.
// Placeholders are marked, and `wrangler d1 create` and `wrangler r2 bucket create` print the
// values you need.
//
// This is for running the Workers in your own Cloudflare account (deploy/README.md). Running
// them on your own hardware needs none of it: see selfhost/README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mushroom-messaging",
  "main": "worker.js",
  "compatibility_date": "2026-07-25",

  // App Store activation needs it: @apple/app-store-server-library uses node builtins
  // (Buffer, crypto). The import is inside the request handler, not at module scope, because
  // jsrsasign generates randomness in its module body and workerd refuses that in global
  // scope. See worker.js.
  "compatibility_flags": ["nodejs_compat"],

  // As in mushroom-files, no "assets" block: the website worker (Mushroom_www) serves every
  // repo-root file as a static asset and matches assets before code, so a file named like a
  // route would silently shadow it. This worker is code only.

  "observability": { "enabled": true },

  "vars": {
    // The App Store build presents AppTransaction's JWS instead of a Gumroad key, and Apple's
    // verifier needs the numeric App Store id to check it against the right app. Public (it's in
    // every App Store URL), so it lives in version control, not in a wrangler secret.
    "APPSTORE_APP_APPLE_ID": "6792833686"

    // Optional. Space or comma separated App Store product ids for the Friends and Spore Storage
    // subscription, matching StoreEntitlement.productIDMonthly / .productIDYearly in the app.
    // Empty (the default) means this deployment sells none, right for a self-hosted box: its
    // ENTITLEMENT_CUTOVER is 0, so nothing asks for a subscription.
    // ,"APPSTORE_SUBSCRIPTION_PRODUCT_IDS": "com.qubit.shroomy.app.membership.monthly com.qubit.shroomy.app.membership.yearly"

    // Optional. Unix seconds. Purchases before this instant keep Friends forever; after it, a
    // live subscription is required. The code default, 0, grandfathers everyone, which a
    // self-hosted box should keep: an install that never expires or asks about a subscription.
    //
    // 0 also makes this a no-op deploy on our servers. Flip it only once a build that can sell a
    // subscription is live and adopted; until then a refused user can't buy their way back in.
    // It's a var, not code, so reversing it is one config deploy.
    // ,"ENTITLEMENT_CUTOVER": "0"

    // Optional. Activations per hour per IP, guarding the Gumroad round trip behind
    // /v1/devices/activate; the code default is 10 (`activationsPerHourPerIP`). Raise it if
    // users share one address. The two-instance debug workflow in README.md spends five or six
    // in minutes from one Mac, so the 429 can hit someone testing. Ours runs 20. Read per
    // request, so a change applies immediately.
    // ,"ACTIVATIONS_PER_HOUR_PER_IP": "20"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mushroom-messaging",
      // A second environment needs `wrangler d1 create` and the id it prints. Don't overwrite
      // a working id in place: a wrong id deploys fine and fails at the first query.
      "database_id": "PUT-YOUR-OWN-D1-DATABASE-ID-HERE",
      "migrations_dir": "migrations"
    }
  ],

  // One Durable Object per identity, owning that person's received messages, friend list, live
  // sockets and push tokens. No second class: the inbox already knows all four.
  "durable_objects": {
    "bindings": [
      { "name": "INBOX", "class_name": "UserInbox" }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      // SQLite-backed, not the older key-value storage: message history wants an
      // autoincrementing sequence and a UNIQUE constraint for dedup, free here.
      "new_sqlite_classes": ["UserInbox"]
    }
  ],

  // Daily sweep of expired invites and long-revoked devices. Not message retention: a cron
  // can't enumerate Durable Objects, so each inbox expires its own on the write path. Any
  // minute but :00, where every cron on the platform piles up.
  "triggers": { "crons": ["23 4 * * *"] },

  "routes": [
    { "pattern": "chat.example.com", "custom_domain": true }
  ]
}
