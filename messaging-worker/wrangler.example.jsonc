// EXAMPLE. Copy to wrangler.jsonc and fill in your own values.
//
// The real wrangler.jsonc is not published: it carries the live database ids of our
// hosted deployment. Every placeholder below is marked, and `wrangler d1 create` and
// `wrangler r2 bucket create` print the values you need.
//
// This file is for running the Workers in YOUR OWN Cloudflare account (deploy/README.md).
// Running them on your own hardware needs none of it: see selfhost/README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mushroom-messaging",
  "main": "worker.js",
  "compatibility_date": "2026-07-25",

  // Required by the App Store activation path: @apple/app-store-server-library
  // needs node builtins (Buffer, crypto). The import itself is deliberately inside the
  // request handler, not at module scope, because jsrsasign generates randomness while
  // its module body runs and workerd refuses that in global scope. See worker.js.
  "compatibility_flags": ["nodejs_compat"],

  // Same rule as mushroom-files: deliberately NO "assets" block. The website worker
  // (Mushroom_www) serves every repo-root file as a static asset and matches assets BEFORE
  // code, so a file named like a route would silently shadow it. This worker is code only.

  "observability": { "enabled": true },

  "vars": {
    // The App Store build presents AppTransaction's JWS instead of a Gumroad key, and
    // Apple's verifier needs the app's numeric App Store id to check it against the
    // right app. Public, not a secret: it is the id in every App Store URL, which is why
    // it sits here in version control rather than in a wrangler secret nobody can see.
    "APPSTORE_APP_APPLE_ID": "6792833686"

    // Optional. Space or comma separated App Store product ids for the Friends and Spore Storage
    // subscription, matching StoreEntitlement.productIDMonthly / .productIDYearly in the app.
    // Empty (the default) means this deployment does not sell one, which is right for a
    // self-hosted box: its ENTITLEMENT_CUTOVER is 0, so nothing ever asks for a subscription.
    // ,"APPSTORE_SUBSCRIPTION_PRODUCT_IDS": "com.qubit.shroomy.app.membership.monthly com.qubit.shroomy.app.membership.yearly"

    // Optional. Unix seconds. Purchases from BEFORE this instant keep Friends forever; from
    // after it, a live subscription is required. The code default is 0, which means
    // grandfather everyone, and that is what a self-hosted box should keep: it makes an
    // install that never expires and never asks Gumroad about a subscription.
    //
    // Leaving it 0 is also how this deploys as a no-op on our own servers. Flip it only once
    // a build that can actually sell a subscription is live and adopted, because until then
    // a refused user has no way to buy their way back in. Reversing it is one config deploy
    // and no code change, which is exactly why it lives here and not in worker.js.
    // ,"ENTITLEMENT_CUTOVER": "0"

    // Optional. Activations per hour per IP, guarding the Gumroad round trip behind
    // /v1/devices/activate; the code default is 10 (`activationsPerHourPerIP`). Worth
    // raising on a box whose users share one address, and worth knowing about if you run
    // the two-instance debug workflow in README.md: a single Mac spends five or six in a
    // few minutes, so the 429 lands on somebody testing rather than on a flood. Our own
    // deployment runs 20. Applied per request, so a change takes effect immediately
    // rather than at the next window.
    // ,"ACTIVATIONS_PER_HOUR_PER_IP": "20"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mushroom-messaging",
      // The REAL id of the deployed database, not a placeholder. Setting up a second
      // environment means `wrangler d1 create` and the id it prints; do not overwrite this
      // one in place, because a wrong id deploys fine and fails at the first query.
      "database_id": "PUT-YOUR-OWN-D1-DATABASE-ID-HERE",
      "migrations_dir": "migrations"
    }
  ],

  // One Durable Object per identity. It owns that person's received messages, their friend
  // list, their live sockets and their push tokens, which is why there is no second class:
  // the inbox is already the only thing that knows all four.
  "durable_objects": {
    "bindings": [
      { "name": "INBOX", "class_name": "UserInbox" }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      // SQLite-backed, not the older key-value storage. Message history wants an
      // autoincrementing sequence and a UNIQUE constraint for dedup, and both are free here
      // and hand-rolled otherwise.
      "new_sqlite_classes": ["UserInbox"]
    }
  ],

  // Daily sweep of expired invites and long-revoked devices. NOT message retention: a cron
  // cannot enumerate Durable Objects, so each inbox expires its own messages on the write
  // path. Minute deliberately not :00, where every cron on the platform piles up.
  "triggers": { "crons": ["23 4 * * *"] },

  "routes": [
    { "pattern": "chat.example.com", "custom_domain": true }
  ]
}
