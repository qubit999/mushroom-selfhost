using Workerd = import "/workerd/workerd.capnp";
using MessagingModules = import "dist/messaging/modules.capnp";
using FilesModules = import "dist/files/modules.capnp";

# Mushroom on your own hardware.
#
# Copy this file, fill in the CHANGE ME values, and run:
#   workerd serve config.capnp
#
# Start selfhost/blobd.mjs alongside it, or uploads have nowhere to go. Both have systemd units
# in selfhost/systemd.
#
# This deployment can't make an outbound request, a stronger thing to hand a security team than
# any application-level allowlist.
#
# `globalOutbound = "no-internet"` on each worker enforces that, and it must. Leaving the
# `internet` service undefined does nothing: workerd defaults globalOutbound to a real network
# service, so without these lines the config reaches the public internet (verified). Don't delete
# the service below as redundant.

const config :Workerd.Config = (
  services = [
    (name = "messaging", worker = .messaging),
    (name = "files", worker = .files),

    # Durable Object storage. These hold both the message ciphertext and the databases, so a
    # backup is these two directories.
    (name = "do-messaging", disk = (path = "/var/lib/mushroom/do-messaging", writable = true)),
    (name = "do-files", disk = (path = "/var/lib/mushroom/do-files", writable = true)),

    # The blob store, standing in for R2. Not a workerd `disk` service, which serves only GET and
    # HEAD, with no DELETE or Range; both matter here. selfhost/blobd.mjs listens on this socket.
    (name = "blobs", external = (address = "unix:/run/mushroom/blobd.sock", http = ())),

    # An outbound network that allows nothing. See the note at the top: this is what keeps the
    # box from phoning home.
    #
    # The empty allow list is the whole mechanism. Don't add a `deny` list to "reinforce" it:
    # workerd rejects denying 'public' and dies at startup on a fatal exception.
    (name = "no-internet", network = (allow = [])),
  ],

  sockets = [
    # Plain http on loopback. TLS is terminated in front, because the app refuses anything but
    # https and Apple's ATS has no exemption in either build.
    #
    # Note the crossing: the files worker gets the bare :443 address, because `PUBLIC_BASE` is
    # the one address seen by people not running Mushroom; it's in every share link. Friends
    # takes the port.
    #
    #   tailscale serve --bg --https=443  http://127.0.0.1:8081     # file sharing
    #   tailscale serve --bg --https=8443 http://127.0.0.1:8080     # friends
    #
    # tailscale renews its own certificate, which beats `tailscale cert` plus workerd TLS
    # sockets. With internal PKI and your own DNS name, use an `https` socket with tlsOptions.
    (name = "messaging-http", address = "127.0.0.1:8080", http = (), service = "messaging"),
    (name = "files-http", address = "127.0.0.1:8081", http = (), service = "files"),

    # Operator and test surface, on unix sockets only, so they're unreachable over the network
    # whatever the proxy forwards.
    (name = "messaging-admin", address = "unix:/run/mushroom/admin.sock", http = (),
     service = (name = "messaging", entrypoint = "Admin")),
    (name = "files-admin", address = "unix:/run/mushroom/files-admin.sock", http = (),
     service = (name = "files", entrypoint = "Admin")),
  ],
);

const messaging :Workerd.Worker = (
  modules = MessagingModules.modules,

  # Copied from messaging-worker/wrangler.jsonc; move them together, or the two environments
  # stop being the same runtime.
  compatibilityDate = "2026-07-25",
  compatibilityFlags = ["nodejs_compat"],

  # Where `fetch()` goes. Without this line it goes to the real internet.
  globalOutbound = "no-internet",

  durableObjectNamespaces = [
    (className = "UserInbox", uniqueKey = "CHANGE-ME-mushroom-inbox", enableSql = true),
    (className = "SqlStore", uniqueKey = "CHANGE-ME-mushroom-sql", enableSql = true),
  ],
  durableObjectStorage = (localDisk = "do-messaging"),

  bindings = [
    (name = "INBOX", durableObjectNamespace = "UserInbox"),
    (name = "SQL", durableObjectNamespace = "SqlStore"),

    # The whole box shares one activation bucket: behind a local proxy there's no trustworthy
    # client address. A bound on runaway clients, and a flood can use it up for everyone until
    # the hour turns.
    (name = "ACTIVATIONS_PER_HOUR_PER_IP", text = "1000"),

    # A public constant, not a secret. Leave it as is.
    (name = "APPSTORE_APP_APPLE_ID", text = "6792833686"),

    # Where the bare root redirects. Empty names nobody and the root 404s. See the files worker
    # below; dev-config.sh fills both from the same BRAND_URL.
    (name = "BRAND_URL", text = ""),

    # Leave APNS_* unset. Self-hosted deployments have no background notifications, and unset
    # makes that automatic: no token is stored and no timer is armed.

    # CHANGE ME. Who may activate: a space-separated list of licence key hashes, one per person:
    #   printf '%s' 'THEIR-KEY' | tr '[:lower:]' '[:upper:]' | shasum -a 256
    # Use printf, never echo: a trailing newline produces a hash that never matches. Empty
    # refuses every activation. `*` accepts any string as a key, so anyone who can reach the
    # listener activates; use it only where nobody untrusted can.
    (name = "ENROLLMENT_HASHES", text = ""),

    (name = "ADMIN_TOKEN", text = "CHANGE-ME"),
  ],
);

const files :Workerd.Worker = (
  modules = FilesModules.modules,

  compatibilityDate = "2026-07-25",
  compatibilityFlags = ["nodejs_compat"],
  globalOutbound = "no-internet",

  durableObjectNamespaces = [
    (className = "SqlStore", uniqueKey = "CHANGE-ME-mushroom-files-sql", enableSql = true),
  ],
  durableObjectStorage = (localDisk = "do-files"),

  bindings = [
    (name = "SQL", durableObjectNamespace = "SqlStore"),
    (name = "BLOBS", service = "blobs"),

    # One activation bucket for the box, as on messaging. Higher than hosted's 30 because every
    # Mac shares it, including the routine re-activations.
    (name = "ACTIVATIONS_PER_MINUTE_PER_IP", text = "300"),

    # CHANGE ME, and get it right: it's in every share link, so a wrong value sends people
    # somewhere else for files that live here. Include the port if files use one (which is why
    # files gets :443).
    #
    # dev-config.sh substitutes this by matching the literal below; change them together.
    (name = "PUBLIC_BASE", text = "https://CHANGE-ME.example.ts.net"),

    (name = "APPSTORE_APP_APPLE_ID", text = "6792833686"),

    # Where the "this link has expired" and "this file was removed" pages send a visitor, and
    # where the bare root redirects. Empty names nobody: the root 404s and those pages carry no
    # link, the right default for a box that isn't ours. Set your own site to point somewhere.
    #
    # docker-entrypoint.sh substitutes this from BRAND_URL in .env; change them together.
    (name = "BRAND_URL", text = ""),

    # Leave TURNSTILE_SECRET_KEY and the EMAIL binding unset and the abuse report form stays off:
    # it needs Turnstile to check a submission and EMAIL to deliver it. Handle misuse through
    # your own policies and the admin commands.
    #
    # If you serve your own report.html, add REPORT_ORIGINS too, comma separated, or the Worker
    # refuses your page's origin in favour of ours:
    #   (name = "REPORT_ORIGINS", text = "https://intranet.example.com"),

    # CHANGE ME. See the note on the messaging worker above.
    (name = "ENROLLMENT_HASHES", text = ""),
    (name = "ADMIN_TOKEN", text = "CHANGE-ME"),
  ],
);
